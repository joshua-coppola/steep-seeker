{% extends "page_base.jinja" %}

{% block title %}
Search Ski Resorts
{% endblock title %}

{% block pagehead %}
<link href="{{ asset_url('/search.css') }}" rel="stylesheet" />
<link href="{{ asset_url('/form.css') }}" rel="stylesheet" />
{% endblock pagehead %}

{% block content %}
<h1 id="title">Search Mountains</h1>

<section id="sidebar">
    <h2>Filters</h2>
    {# only shown in the mobile layout, where the filters start collapsed #}
    <button type="button" class="button-cta2 collapse-toggle" aria-expanded="false" aria-controls="filters"
        onclick="toggleCollapse(this)">
        <img alt="" height="17" width="17" src="/hamburger-menu-light.svg">
        Filters
    </button>

    <form id="filters" class="collapsible"></form>
    <div id="ezoic-pub-ad-placeholder-107"></div>
</section>

<section id="content">
    <form id="search-form" class="search-form">
        <input id="search" name="q" type="search" placeholder="Search all mountains" />
        <!-- Rework this field to click on arrow to change sort direction instead of having dropdown for each -->
        <select id="sort" name="sort">
            <option value="name-asc">Name A-Z</option>
            <option value="name-desc">Name Z-A</option>
            <option value="difficulty-asc">Difficulty &#x25b2;</option>
            <option value="difficulty-desc">Difficulty &#x25bc;</option>
            <option value="beginner_friendliness-asc">Beginner Friendliness &#x25b2;</option>
            <option value="beginner_friendliness-desc">Beginner Friendliness &#x25bc;</option>
            <option value="vertical-asc">Vertical Drop &#x25b2;</option>
            <option value="vertical-desc">Vertical Drop &#x25bc;</option>
            <option value="trail_count-asc">Trail Count &#x25b2;</option>
            <option value="trail_count-desc">Trail Count &#x25bc;</option>
        </select>
        <input class="button-cta" id="submit" type="submit" value="Search" />
    </form>

    <div id="ezoic-pub-ad-placeholder-102"></div>

    <div class="links">
        {% if 'prev' in pages %}
        <div class="column-left">
            <a class="button-cta2" href="{{pages.prev}}">&#x25C0; Previous Page</a>
        </div>
        {% endif %}

        {% if 'next' in pages %}
        <div class="column-right">
            <a class="button-cta2" href="{{pages.next}}">Next Page &#x25B6;</a>
        </div>
        {% endif %}
    </div>

    {% set inline_ads = inline_ad_slots(mountains|length) %}
    <ul class="results">
        {% for mountain in mountains %}
        <li class="result">
            <a href="/interactive-map/{{mountain.state.value}}/{{mountain.name}}">
                <img alt="{{mountain.name}} - {{mountain.state.value}}" class="thumbnail" src="thumbnails/{{mountain.state.value}}/{{mountain.name}}.svg" width=125px
                    height=100px />
            </a>
            <h2><a href="/interactive-map/{{mountain.state.value}}/{{mountain.name}}" style="color: black">{{mountain.name}}</a></h2>
            <div>
                {% if mountain.difficulty > 0 %}
                {% if mountain.beginner_friendliness > display_beginner_friendliness(difficulty_thresholds.beginner_max) %}
                <span class="icon difficulty-green"></span>
                {% endif %}
                {% endif %}
                {% if mountain.difficulty >= difficulty_thresholds.beginner_max %}
                {% if mountain.beginner_friendliness > display_beginner_friendliness(difficulty_thresholds.intermediate_max) %}
                <span class="icon difficulty-royalblue"></span>
                {% endif %}
                {% endif %}
                {% if mountain.difficulty >= difficulty_thresholds.intermediate_max %}
                {% if mountain.beginner_friendliness > display_beginner_friendliness(difficulty_thresholds.advanced_max) %}
                <span class="icon difficulty-black"></span>
                {% endif %}
                {% endif %}
                {% if mountain.difficulty >= difficulty_thresholds.advanced_max %}
                {% if mountain.beginner_friendliness > display_beginner_friendliness(difficulty_thresholds.expert_max) %}
                <span class="icon difficulty-red"></span>
                {% endif %}
                {% endif %}
                {% if mountain.difficulty >= difficulty_thresholds.expert_max %}
                <span class="icon difficulty-gold"></span>
                {% endif %}
            </div>
            <p class="copy">
                {{mountain.state.value}} — {{mountain.trail_count}} Trails — {{mountain.vertical}}' Vertical
            </p>
            <a class="map-link" href="/interactive-map/{{mountain.state.value}}/{{mountain.name}}">View map</a>
        </li>
        {% if loop.index in inline_ads %}
        <li class="result-ad"><div id="ezoic-pub-ad-placeholder-{{ inline_ads[loop.index] }}"></div></li>
        {% endif %}
        {% endfor %}
        {% if not mountains %}
        <p>No results found. Please double check spelling, and keep in mind that only US mountains are in the system.</p>
        {% endif%}
    </ul>

    <div class="links">
        {% if 'prev' in pages %}
        <div class="column-left">
            <a class="button-cta2" href="{{pages.prev}}">&#x25C0; Previous Page</a>
        </div>
        {% endif %}

        {% if 'next' in pages %}
        <div class="column-right">
            <a class="button-cta2" href="{{pages.next}}">Next Page &#x25B6;</a>
        </div>
        {% endif %}
    </div>

    <div id="ezoic-pub-ad-placeholder-101"></div>
    <script>
        ezstandalone.cmd.push(function () {
            // the ads between results (see inline_ad_slots) show at every width
            const ads = [101, 102].concat({{ inline_ads.values()|list|tojson }});
            // the sidebar ad slot (107) overflows and breaks the layout when an ad
            // fills it with less than 300px of room, so drop it then instead of
            // requesting an ad for it; this also covers the mobile layout, which
            // hides the sidebar (0px wide)
            const sidebarAd = document.getElementById("ezoic-pub-ad-placeholder-107");
            if (sidebarAd.offsetWidth < 300) {
                sidebarAd.remove();
            } else {
                ads.push(107);
            }
            ezstandalone.showAds(...ads);
        });
    </script>

</section>
{% endblock content %}

{% block postbody %}
<script src="{{ asset_url('/search.js') }}"></script>
{% endblock postbody %}
