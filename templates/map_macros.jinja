{# Defines createMountainMap(trails): builds the Leaflet map in #map for
   this mountain (rotated to its bearing, centered on it) and returns it,
   ready to pass to run_map(). Hover-highlighting (almostOnMouseMove) is
   turned off for resorts with over 200 features, where it gets slow. #}
{% macro create_map_js(mountain) %}
        function createMountainMap(trails) {
            var mouseOver = Object.keys(trails.features).length <= 200;
            return L.map('map', {
                rotate: true,
                rotateControl: {
                    closeOnZeroBearing: false,
                },
                touchRotate: false,
                bearing: {{mountain.bearing()}},
                almostOnMouseMove: mouseOver,
            }).setView([{{mountain.coordinates.y}},{{mountain.coordinates.x}}], 13);
        }
{% endmacro %}
