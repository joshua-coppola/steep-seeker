{% extends "page_base.jinja" %}

{% block title %}
Privacy Policy
{% endblock title %}

{% block pagehead %}
<link href="{{ asset_url('/about.css') }}" rel="stylesheet" />
{% endblock pagehead %}

{% block content %}
<section id="content">
    <section class="blurb top-blurb qa">
        <div></div>
        <div>
            <h1>Privacy Policy</h1>
            <p><em>Last updated November 3, 2026</em></p>

            <p>This policy covers steepseeker.com and the Steep Seeker Android app, which
            displays the same website. Steep Seeker does not have user accounts and does
            not ask you for personal information such as your name or email address. The
            data that is collected comes from the sources described below.</p>
        </div>
    </section>
    <section class="blurb qa">
        <div></div>
        <div>
            <h2>Server Logs</h2>
            <p>Like most websites, our web server automatically keeps a standard log of
            every request it receives. Each log entry contains:</p>
            <ul class="bullets">
                <li>Your IP address</li>
                <li>The date and time of the request</li>
                <li>The page or file requested, including any search terms or filters in
                the URL</li>
                <li>The page that linked you to us (the referrer), if your browser sends
                it</li>
                <li>Your browser's user agent string, which identifies your browser,
                operating system, and device type</li>
                <li>The response status and size</li>
            </ul>
            <p>These logs are used only to keep the site secure and running, diagnose
            errors, prevent abuse, and understand overall traffic. They are deleted
            automatically after 14 days. They are not sold or shared with anyone,
            other than being stored on the server of our hosting provider.</p>
        </div>
    </section>
    <section class="blurb qa">
        <div></div>
        <div>
            <h2>Cloudflare</h2>
            <p>Steep Seeker uses Cloudflare to deliver the site quickly and protect it
            from attacks and abuse. All requests to the site pass through Cloudflare's
            network, so Cloudflare processes your IP address, the pages you request, and
            your browser's user agent. Cloudflare may set cookies needed for security,
            such as to recognize traffic that has already passed a security challenge,
            and may show a verification page to traffic that looks suspicious. Cloudflare
            handles this data under the <a href="https://www.cloudflare.com/privacypolicy/"
            target="_blank" rel="noopener">Cloudflare Privacy Policy</a>.</p>
        </div>
    </section>
    <section class="blurb qa">
        <div></div>
        <div>
            <h2>Google Analytics</h2>
            <p>We use Google Analytics to understand how visitors use the site, such as
            which pages are popular and how people find us. Google Analytics uses cookies
            and collects information including the pages you visit, how long you stay,
            your device and browser type, your approximate location (derived from your IP
            address), and the site that referred you. This information is processed by
            Google under the <a href="https://policies.google.com/privacy" target="_blank"
            rel="noopener">Google Privacy Policy</a>. You can opt out by blocking cookies
            in your browser or by installing the
            <a href="https://tools.google.com/dlpage/gaoptout" target="_blank"
            rel="noopener">Google Analytics opt-out browser add-on</a>.</p>
        </div>
    </section>
    <section class="blurb qa">
        <div></div>
        <div>
            <h2>Third-Party Content</h2>
            <p>Some pages load resources directly from other providers: satellite map
            imagery on the interactive map comes from Esri (ArcGIS Online), and some
            JavaScript libraries are served by the unpkg and jsDelivr content delivery
            networks. When your browser requests these resources, those providers receive
            your IP address and user agent, as any website would.</p>
        </div>
    </section>
    <section class="blurb qa">
        <div></div>
        <div>
            <h2>Local Storage</h2>
            <p>The site saves your light/dark theme preference in your browser's local
            storage. This stays on your device and is never sent to us.</p>
        </div>
    </section>
    <section class="blurb qa">
        <div></div>
        <div>
            <h2>Children</h2>
            <p>Steep Seeker is not directed at children under 13, and we do not knowingly
            collect personal information from them.</p>
        </div>
    </section>
    <section class="blurb qa">
        <div></div>
        <div>
            <h2>Contact</h2>
            <p>If you have questions about this policy or your data, you can reach us
            through the Discord or Instagram links on the <a href="/about">About</a>
            page.</p>
        </div>
    </section>
    <section class="blurb qa">
        <div></div>
        <div>
            <h2>Changes to This Policy</h2>
            <p>If this policy changes, the updated version will be posted on this page
            with a new "last updated" date.</p>
        </div>
    </section>
    <section class="blurb qa">
        <div></div>
        <div>
            <h2>Advertising</h2>
            <p>Steep Seeker is supported by ads served by Ezoic, which may collect
            additional data for advertising purposes. You can manage your ad consent
            choices through the consent banner. Ezoic's policy is included below.</p>
            <span id="ezoic-privacy-policy-embed"></span>
        </div>
    </section>
</section>
{% endblock content %}
