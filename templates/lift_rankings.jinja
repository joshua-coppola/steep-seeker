{% extends "page_base.jinja" %}
{% import "filters_sidebar.jinja" as filters with context %}
{% from "lift_icons.jinja" import lift_icons %}

{% block title %}
Lift Rankings - Compare Chairlifts Across the USA
{% endblock title %}

{% block pagehead %}
{{ filters.head() }}
<link href="{{ asset_url('/trail_rankings.css') }}" rel="stylesheet" />
{% endblock pagehead %}

{% block content %}
{# lifts are filtered by their resort's location/season pass; difficulty,
   trail count and vertical describe a mountain, so they're left out. On
   phones one toggle folds away both the filters and the explanation #}
{{ filters.sidebar("Lift Rankings", 107, toggle_label="Filters &amp; Info", also_controls="ranking-info", groups="location,season_pass") }}

<section id="content" class="pane lift-rankings-page">
    <h1 class="desktop-title">Lift Rankings</h1>

    {# folded away on phones, behind the sidebar's Filters & Info toggle #}
    <div id="ranking-info" class="collapsible">
        {# the card layout's sort buttons; the table sorts by its headers #}
        <ul class="ranking-sort mobile">
            {% set sorts = {
                "vertical": "Vertical Rise",
                "length": "Length",
                "average_slope": "Average Pitch",
                "occupancy": "Occupancy",
                "capacity": "Capacity",
            } %}

            {% for key, label in sorts.items() %}
                <li>
                    {% if sort_by == key %}
                        <a class="button-cta">{{ label }}</a>
                    {% else %}
                        <a class="button-cta2" href="{{ pages.first }}&sort={{ key }}">
                            {{ label }}
                        </a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>

        <p class="detail">
            Lifts can be filtered by their resort's location and season pass to find what lifts are the longest, or
            sorted by steepest pitch to find which lifts would be best to lap to get the most vertical.
        </p>
    </div>

    <div class="share-row"><button type="button" class="button-cta2 share-button" data-share>Share⤷</button></div>

    {# the badges lift_icons() puts after lift names; quads stand in for
       every chair size #}
    <div class="legend lift-legend">
        <ul>
            <li><img src="/icons/quad_chair.svg" class="lift-icon chair" alt=""/><span>Chairlift</span></li>
            <li><img src="/icons/quad_bubble_chair.svg" class="lift-icon chair" alt=""/><span>Bubble Chairlift</span></li>
            <li><img src="/icons/gondola.svg" class="lift-icon gondola" alt=""/><span>Gondola/<wbr>Tram</span></li>
            <li><img src="/icons/surface_lift.svg" class="lift-icon surface" alt=""/><span>Surface Lift</span></li>
            <li><img src="/icons/heated.svg" class="lift-icon heated" alt=""/><span>Heated</span></li>
            <li><img src="/icons/express.svg" class="lift-icon express" alt=""/><span>Express</span></li>
        </ul>
    </div>

    <div id="ezoic-pub-ad-placeholder-102"></div>

    <div class="links">
        {% if 'prev' in pages %}
        <div class="column-left">
            <a class="button-cta2" href="{{pages.prev}}">&#x25C0; Previous Page</a>
        </div>
        {% endif %}

        {% if 'next' in pages %}
        <div class="column-right">
            <a class="button-cta2" href="{{pages.next}}">Next Page &#x25B6;</a>
        </div>
        {% endif %}
    </div>

    <div class="trail-table desktop">
        <table>
            <tr>
                <th>Lift Name</th>
                <th>Resort</th>
                <th>State</th>
                {% if sort_by == "vertical"%}
                <th><a class="active">Vertical Rise</a></th>
                {% else %}
                <th><a href="{{pages.first}}&sort=vertical">Vertical Rise</a></th>
                {% endif %}
                {% if sort_by == "length"%}
                <th><a class="active">Length</a></th>
                {% else %}
                <th><a href="{{pages.first}}&sort=length">Length</a></th>
                {% endif %}
                {% if sort_by == "average_slope"%}
                <th><a class="active">Average Pitch</a></th>
                {% else %}
                <th><a href="{{pages.first}}&sort=average_slope">Average Pitch</a></th>
                {% endif %}
                {% if sort_by == "occupancy"%}
                <th><a class="active">Occupancy</a></th>
                {% else %}
                <th><a href="{{pages.first}}&sort=occupancy">Occupancy</a></th>
                {% endif %}
                {% if sort_by == "capacity"%}
                <th><a class="active">Capacity</a></th>
                {% else %}
                <th><a href="{{pages.first}}&sort=capacity">Capacity</a></th>
                {% endif %}
            {% for lift in lifts %}
            {% if not '' == lift.name %}
            <tr>
                <td>
                    <p>{{pages.offset + loop.index}}. <a href="/interactive-map/{{lift.state.value}}/{{lift.resort_name}}?select=lift:{{lift.lift_id}}">
                            {{lift.name}}</a>
                            {{ lift_icons(lift) }}
                        </p>
                </td>
                <td>
                    <a href="/interactive-map/{{lift.state.value}}/{{lift.resort_name}}?select=lift:{{lift.lift_id}}">{{lift.resort_name}}</a>
                    {% for season_pass in lift.season_passes %}
                    <img src="icons/{{season_pass.value}}.{{'svg' if season_pass.value == 'Snow Pass' else 'png'}}" class="pass-icon" alt="{{season_pass.value}}"/>
                    {% endfor %}
                </td>
                <td>{{lift.state.value}}</td>
                <td>{{lift.vertical}} ft</td>
                <td>{{lift.length}} ft</td>
                <td>{{lift.average_slope}}°</td>
                {% if lift.occupancy %}
                    {% if lift.occupancy <= 4 %}
                    <td>
                        {% for i in range(lift.occupancy) %}
                        <span class="icon person"></span>
                        {% endfor %}
                    </td>
                    {% else %}
                    <td class="occupancy">
                        {{lift.occupancy}}<span class="small-spacer"></span><span class="icon person"></span>
                    </td>
                    {% endif %}
                {% else %}
                <td></td>
                {% endif%}
                <td>{% if lift.capacity %}{{lift.capacity}}<span class="small-spacer"></span><span class="icon person"></span>/hr{% endif %}</td>
            </tr>
            {% endif %}
            {% endfor %}

        </table>
    </div>

    {# ads between results (see inline_ad_slots) only go in this phone
       layout; the desktop table has no spot for them #}
    {% set inline_ads = inline_ad_slots(lifts|length) %}
    <div class="trail-table mobile">
        {% for lift in lifts %}
        {% if not '' == lift.name %}
        <div class="header">
            <table class="header">
                <tr>
                    <td>
                        {{pages.offset + loop.index}}. <a href="/interactive-map/{{lift.state.value}}/{{lift.resort_name}}?select=lift:{{lift.lift_id}}">
                                {{lift.name}}, {{lift.resort_name}} ({{lift.state.value}})</a>
                                {{ lift_icons(lift) }}
                            {% for season_pass in lift.season_passes %}
                            <img src="icons/{{season_pass.value}}.{{'svg' if season_pass.value == 'Snow Pass' else 'png'}}" class="pass-icon" alt="{{season_pass.value}}"/>
                            {% endfor %}
                    </td>

                </tr>
            </table>
        </div>
        <table>
            {% if sort_by == "vertical"%}
            <tr style="background-color: var(--color-accent-very-light)">
            {% else %}
            <tr>
            {% endif %}
                <td style="width:50%">Vertical Rise</td>
                <td style="width:50%">
                    {{lift.vertical}} ft
                </td>
            </tr>
            {% if sort_by == "length"%}
            <tr style="background-color: var(--color-accent-very-light)">
            {% else %}
            <tr>
            {% endif %}
                <td>Length</td>
                <td>
                    {{lift.length}} ft
                </td>
            </tr>
            {% if sort_by == "average_slope"%}
            <tr style="background-color: var(--color-accent-very-light)">
            {% else %}
            <tr>
            {% endif %}
                <td>Average Pitch</td>
                <td>
                    {{lift.average_slope}}°
                </td>
            </tr>
            {% if sort_by == "occupancy"%}
            <tr style="background-color: var(--color-accent-very-light)">
            {% else %}
            <tr>
            {% endif %}
                <td>Occupancy</td>
                {% if lift.occupancy %}
                    {% if lift.occupancy <= 4 %}
                    <td>
                        {% for i in range(lift.occupancy)%}
                        <span class="icon person"></span>
                        {% endfor %}
                    </td>
                    {% else %}
                    <td class="occupancy">
                        {{lift.occupancy}}<span class="small-spacer"></span><span class="icon person"></span>
                    </td>
                    {% endif %}
                {% else %}
                <td>--</td>
                {% endif %}
            </tr>
            {% if sort_by == "capacity"%}
            <tr style="background-color: var(--color-accent-very-light)">
            {% else %}
            <tr>
            {% endif %}
                <td>Capacity</td>
                <td>
                {% if lift.capacity %}
                    {{lift.capacity}}<span class="small-spacer"></span><span class="icon person"></span>/hr
                {% else %}
                    --
                {% endif %}
                </td>
            </tr>
        {% endif%}
        </table>
        {% if loop.index in inline_ads %}
        <div class="inline-ad" id="ezoic-pub-ad-placeholder-{{ inline_ads[loop.index] }}"></div>
        {% endif %}
        {% endfor %}
    </div>

    <div class="links">
        {% if 'prev' in pages %}
        <div class="column-left">
            <a class="button-cta2" href="{{pages.prev}}">&#x25C0; Previous Page</a>
        </div>
        {% endif %}

        {% if 'next' in pages %}
        <div class="column-right">
            <a class="button-cta2" href="{{pages.next}}">Next Page &#x25B6;</a>
        </div>
        {% endif %}
    </div>
    <div id="ezoic-pub-ad-placeholder-101"></div>
    <script>
        ezstandalone.cmd.push(function () {
            const ads = [101, 102];
            const inlineAds = {{ inline_ads.values()|list|tojson }};
            // the ads between results (see inline_ad_slots) are only in the
            // card layout (trail_rankings.css shows it when the results pane
            // is too narrow for the table), so drop them while the table
            // shows instead of requesting ads for them
            if (document.querySelector(".trail-table.mobile").checkVisibility()) {
                ads.push(...inlineAds);
            } else {
                inlineAds.forEach(function (id) {
                    document.getElementById("ezoic-pub-ad-placeholder-" + id).remove();
                });
            }
            // the sidebar ad slot (107) overflows and breaks the layout when an ad
            // fills it with less than 300px of room, so drop it then instead of
            // requesting an ad for it; this also covers the mobile layout, which
            // hides the sidebar (0px wide)
            const sidebarAd = document.getElementById("ezoic-pub-ad-placeholder-107");
            if (sidebarAd.offsetWidth < 300) {
                sidebarAd.remove();
            } else {
                ads.push(107);
            }
            ezstandalone.showAds(...ads);
        });
    </script>

</section>
{% endblock content %}

{% block postbody %}
{{ filters.script() }}
{% endblock postbody %}
