{% extends "management.jinja" %}
{% import "map_macros.jinja" as map_macros with context %}

{% block title %}
Edit Resort
{% endblock title %}

{% block pagehead %}
{{ map_macros.leaflet_assets() }}
<link href="{{ asset_url('/map_shared.css') }}" rel="stylesheet" />
<link href="{{ asset_url('/management-edit-resort.css') }}" rel="stylesheet" />
{% endblock pagehead %}

{% block insideContent %}
    <form id="search-form" class="search-form">
        <select id="search" name="q" type="search">
            <option value="" disabled selected>Select Resort</option>
            {% for resort in resorts %}
            <option value="{{resort}}">{{resort}}</option>
            {% endfor %}
        </select>
        <input class="button-cta" id="submit" type="submit" value="Search" />
    </form>
    {% if next_mountain %}
    <form id="next_mountain" class="search-form">
        <input type="hidden" name="q" id="q" value="{{next_mountain}}">
        <input class="button-cta" id="next" type="submit" value="Next Resort">
    </form>
    {% endif %}

    {% if mountain %}
    <h2>{{mountain.name}}, {{mountain.state.value}}</h2>
{{ map_macros.overview(mountain, weather_modifier, share=False) }}
    <form id="refresh" class="search-form">
        <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <ul>
        <li>
            <input type="checkbox" id="stats" name="stats_refresh" value=True>
            <label for="stats">From Local OSM & Maps</label>
        </li>
        <li>
            <input type="checkbox" id="maps" name="map_refresh" value=True>
            <label for="maps">Just Maps</label>
        </li>
        <li>
            <input type="checkbox" id="full" name="full_refresh" value=True>
            <label for="full">Fresh OSM & Maps</label>
        </li>
        <li class="nested-option">
        <input type="number" value="0" id="map_size" name="size_increase" step=".1" min="0" disabled>
        <label for="map_size">Additional Area</label>
        </li>
        <li>
            <input type="checkbox" id="areas" name="ignore_areas" value=True>
            <label for="areas">Ignore Areas</label>
        </li>
        <li class="nested-option">
            <input type="checkbox" id="blacklist_areas" name="blacklist_areas" value=True disabled>
            <label for="blacklist_areas">Blacklist Ignored Areas</label>
        </li>
        <li>
            <input type="checkbox" id="preserve_modifiers" name="preserve_modifiers" value=True checked>
            <label for="preserve_modifiers">Preserve Manual Modifiers</label>
        </li>
        </ul>
        <input class="button-cta" id="submit" type="submit" value="Refresh" />
    </form>
    <script>
        (function () {
            // each [parent checkbox, dependent sub-option] pair: the
            // sub-option is only usable while its parent is checked, and
            // is reset when the parent is unchecked
            const dependents = [
                ["areas", "blacklist_areas"],
                ["full", "map_size"],
            ];
            for (const [parentId, childId] of dependents) {
                const parent = document.getElementById(parentId);
                const child = document.getElementById(childId);
                const sync = () => {
                    child.disabled = !parent.checked;
                    if (!parent.checked) {
                        if (child.type === "checkbox") {
                            child.checked = false;
                        } else {
                            child.value = child.defaultValue;
                        }
                    }
                };
                parent.addEventListener("change", sync);
                sync();
            }
        })();
    </script>
    <form id="rename" class="search-form">
        <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <input id="rename" name="rename" type="search" placeholder="New Resort Name" />
        <input class="button-cta" id="submit" type="submit" value="Rename" />
    </form>
    <div class="rotate-buttons">
        <form id="rotate_ccw" class="search-form">
            <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
            <input type="hidden" name="rotate_ccw" value="True">
            <input class="button-cta2" id="rotate_ccw_submit" type="submit" value="&#8634; Rotate CCW" />
        </form>
        <form id="rotate_cw" class="search-form">
            <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
            <input type="hidden" name="rotate" value="True">
            <input class="button-cta2" id="rotate_cw_submit" type="submit" value="&#8635; Rotate CW" />
        </form>
    </div>
    <form id="change_url" class="search-form">
        <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <input id="new_url" name="url" type="search" placeholder="New Resort URL" />
        <input class="button-cta" id="submit" type="submit" value="Change URL" />
    </form>
    <form id="pass" class="search-form">
        <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <input type="hidden" name="update_passes" value="True">
        <span class="checkbox-group">
            <input type="checkbox" id="epic" name="epic" value="True" {% if "Epic" in season_pass_values %}checked{% endif %}>
            <label for="epic">Epic</label>
        </span>
        <span class="checkbox-group">
            <input type="checkbox" id="ikon" name="ikon" value="True" {% if "Ikon" in season_pass_values %}checked{% endif %}>
            <label for="ikon">Ikon</label>
        </span>
        <span class="checkbox-group">
            <input type="checkbox" id="mountain_collective" name="mountain_collective" value="True" {% if "Mountain Collective" in season_pass_values %}checked{% endif %}>
            <label for="mountain_collective">Mountain Collective</label>
        </span>
        <span class="checkbox-group">
            <input type="checkbox" id="indy" name="indy" value="True" {% if "Indy" in season_pass_values %}checked{% endif %}>
            <label for="indy">Indy</label>
        </span>
        <span class="checkbox-group">
            <input type="checkbox" id="snow_pass" name="snow_pass" value="True" {% if "Snow Pass" in season_pass_values %}checked{% endif %}>
            <label for="snow_pass">Snow Pass</label>
        </span>
        <span class="checkbox-group">
            <input type="checkbox" id="powder_alliance" name="powder_alliance" value="True" {% if "Powder Alliance" in season_pass_values %}checked{% endif %}>
            <label for="powder_alliance">Powder Alliance</label>
        </span>
        <span class="checkbox-group">
            <input type="checkbox" id="freedom" name="freedom" value="True" {% if "Freedom" in season_pass_values %}checked{% endif %}>
            <label for="freedom">Freedom</label>
        </span>
        <span class="checkbox-group">
            <input type="checkbox" id="power" name="power" value="True" {% if "Power" in season_pass_values %}checked{% endif %}>
            <label for="power">Power</label>
        </span>
        <input class="button-cta" id="submit" type="submit" value="Update" />
    </form>
    <div id='map'></div>
    <form id="bulk-delete" class="search-form" method="post"
          action="/management-edit-resort/bulk-delete" hidden>
        <input type="hidden" name="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <span id="bulk-delete-count">0 flagged</span>
        <span class="checkbox-group">
            <input type="checkbox" id="bulk_blacklist" name="blacklist" value="True">
            <label for="bulk_blacklist">Blacklist</label>
        </span>
        <input class="button-cta" id="bulk-delete-submit" type="submit" value="Delete Flagged" />
    </form>
    <form id="bulk-modifiers" class="search-form" method="post"
          action="/management-edit-resort/bulk-modifiers" hidden>
        <input type="hidden" name="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <span id="bulk-modifiers-count">0 flagged</span>
        <span class="checkbox-group">
            <input type="checkbox" id="bulk_gladed" name="gladed" value="True">
            <label for="bulk_gladed">Gladed</label>
        </span>
        <span class="checkbox-group">
            <input type="checkbox" id="bulk_ungroomed" name="ungroomed" value="True">
            <label for="bulk_ungroomed">Ungroomed</label>
        </span>
        <span class="checkbox-group">
            <input type="checkbox" id="bulk_hazardous" name="hazardous" value="True">
            <label for="bulk_hazardous">Hazardous</label>
        </span>
        <input class="button-cta" id="bulk-modifiers-submit" type="submit" value="Apply to Flagged" />
    </form>
    <form id="delete_resort" class="search-form">
        <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <input id="confirmation" name="delete_resort" type="search" placeholder="Type 'DELETE' to confirm" />
        <span class="checkbox-group">
            <input type="checkbox" id="delete_osm" name="delete_osm" value="True">
            <label for="delete_osm">Delete OSM</label>
        </span>
        <input class="button-cta" id="submit" type="submit" value="Delete Resort" />
    </form>
{{ map_macros.trail_list(trails, selectable=True) }}
{{ map_macros.lift_list(lifts, selectable=True) }}
{{ map_macros.hike_list(lifts, selectable=True) }}
    <script>
{{ map_macros.create_map_js(mountain) }}
        let trails = {{ geojson | tojson }};
        run_map(trails, createMountainMap(trails), true, {{ (mountain.name ~ ", " ~ mountain.state.value) | tojson }});
    </script>
    {% else %}
    <p>Select a resort above to view it.</p>
    {% endif %}
{% endblock insideContent %}

{% block floatingContent %}
{% if mountain %}
<div class="map-switch">
    <button class="button-cta2 map-button" id="public-map"><a href="/interactive-map/{{mountain.state.value}}/{{mountain.name}}">Interactive Map</a></button>
</div>
{% endif %}
{% endblock floatingContent %}
