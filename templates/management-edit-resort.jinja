{% extends "management.jinja" %}

{% block title %}
Edit Resort
{% endblock title %}

{% block pagehead %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
     integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
     crossorigin=""></script>

<script type="text/javascript" src="https://cdn.rawgit.com/makinacorpus/Leaflet.GeometryUtil/master/src/leaflet.geometryutil.js">
</script>

<script type="text/javascript" src="https://cdn.jsdelivr.net/gh/makinacorpus/Leaflet.AlmostOver@master/src/leaflet.almostover.js">
</script>

<link href="/interactive-map.css" rel="stylesheet" />
<link href="/management-edit-resort.css" rel="stylesheet" />

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.locatecontrol/dist/L.Control.Locate.min.css" />
<script src="https://cdn.jsdelivr.net/npm/leaflet.locatecontrol/dist/L.Control.Locate.min.js" charset="utf-8"></script>

<script src="https://unpkg.com/leaflet-rotate@0.2.8/dist/leaflet-rotate-src.js"></script>

<script src="/leaflet.textpath.js"></script>

<link rel="stylesheet" href="/node_modules/leaflet.heightgraph/dist/L.Control.Heightgraph.min.css"/>
<script type="text/javascript" src="/node_modules/leaflet.heightgraph/dist/L.Control.Heightgraph.min.js"></script>

<script type="text/javascript" src="/mappings.js"></script>
<script type="text/javascript" src="/interactive-map.js"></script>

{% endblock pagehead %}

{% block insideContent %}
    <form id="search-form" class="search-form">
        <select id="search" name="q" type="search">
            <option value="" disabled selected>Select Resort</option>
            {% for resort in resorts %}
            <option value="{{resort}}">{{resort}}</option>
            {% endfor %}
        </select>
        <input class="button-cta" id="submit" type="submit" value="Search" />
    </form>
    {% if next_mountain %}
    <form id="next_mountain" class="search-form">
        <input type="hidden" name="q" id="q" value="{{next_mountain}}">
        <input class="button-cta" id="next" type="submit" value="Next Resort">
    </form>
    {% endif %}

    {% if mountain %}
    <h2>{{mountain.name}}, {{mountain.state.value}}</h2>
    <ul>
        <li>Trail Count: {{mountain.trail_count()}}</li>
        <li>Lift Count: {{mountain.lift_count()}}</li>
        <li>Vertical: {{mountain.vertical_feet()}} ft</li>
        <li>Difficulty: {{mountain.difficulty}}</li>
        <li>Beginner Friendliness: {{mountain.beginner_friendliness}}</li>
        <li>Last Updated: {{mountain.last_updated.date()}}</li>
        <li><a href="{{mountain.url}}">{{mountain.url}}</a></li>
    </ul>
    <form id="rename" class="search-form">
        <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <input id="rename" name="rename" type="search" placeholder="New Resort Name" />
        <input class="button-cta" id="submit" type="submit" value="Rename" />
    </form>
    <form id="change_url" class="search-form">
        <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <input id="url" name="url" type="search" placeholder="New Resort URL" />
        <input class="button-cta" id="submit" type="submit" value="Change URL" />
    </form>
    <form id="pass" class="search-form">
        <input type="hidden" name="q" id="q" value="{{mountain.name}}, {{mountain.state.value}}">
        <input type="hidden" name="update_passes" value="True">
        <input type="checkbox" id="epic" name="epic" value="True" {% if "Epic" in season_pass_values %}checked{% endif %}>
        <label for="epic">Epic</label>
        <input type="checkbox" id="ikon" name="ikon" value="True" {% if "Ikon" in season_pass_values %}checked{% endif %}>
        <label for="ikon">Ikon</label>
        <input type="checkbox" id="mountain_collective" name="mountain_collective" value="True" {% if "Mountain Collective" in season_pass_values %}checked{% endif %}>
        <label for="mountain_collective">Mountain Collective</label>
        <input type="checkbox" id="indy" name="indy" value="True" {% if "Indy" in season_pass_values %}checked{% endif %}>
        <label for="indy">Indy</label><br>
        <input type="checkbox" id="cooper" name="cooper" value="True" {% if "Cooper" in season_pass_values %}checked{% endif %}>
        <label for="cooper">Cooper</label>
        <input type="checkbox" id="powder_alliance" name="powder_alliance" value="True" {% if "Powder Alliance" in season_pass_values %}checked{% endif %}>
        <label for="powder_alliance">Powder Alliance</label>
        <input type="checkbox" id="freedom" name="freedom" value="True" {% if "Freedom" in season_pass_values %}checked{% endif %}>
        <label for="freedom">Freedom</label><br>
        <input type="checkbox" id="power" name="power" value="True" {% if "Power" in season_pass_values %}checked{% endif %}>
        <label for="power">Power</label>
        <input class="button-cta" id="submit" type="submit" value="Update" />
    </form>
    <div id='map'></div>
    <div class="mountain-section">
        <h2>Trails - Sorted by Difficulty</h2>
        <ul>
            <li><span class="icon gladed"></span>Gladed</li>
            <li><span>&nbsp;&nbsp;</span><span class="icon ungroomed"></span>Ungroomed/Moguls</li>
            {% for trail in trails %}
            {% if not '' == trail.name %}
            <li>
                {% if trail.difficulty < 18 %} <span class="icon difficulty-green"></span>
                    {% else %}
                    {% if trail.difficulty < 27 %} <span class="icon difficulty-royalblue"></span>
                        {% else %}
                        {% if trail.difficulty < 36 %} <span class="icon difficulty-black"></span>
                            {% else %}
                            {% if trail.difficulty < 47 %} <span class="icon difficulty-red"></span>
                                {% else %}
                                <span class="icon difficulty-gold"></span>
                                {% endif %}
                                {% endif %}
                                {% endif %}
                                {% endif %}
                                {{trail.steepest_30m}}° - {{trail.name}}
                                {% if trail.gladed == True %}
                                <span> </span><span class="icon gladed"></span>
                                {% endif %}
                                {% if trail.ungroomed == True %}
                                <span>&nbsp;&nbsp;</span><span class="icon ungroomed"></span>
                                {% endif %}
            </li>
            {% endif %}
            {% endfor %}
        </ul>
    </div>
    <div class="mountain-section">
        <h2>Lifts</h2>
        <ul>
            {% for lift in lifts %}
            {% if not '' == lift.name %}
            <li>{{lift.name}} - {{lift.length_feet()}} ft</li>
            {% endif %}
            {% endfor %}
        </ul>
    </div>
    <script>
        let trails = {{ geojson | tojson }}

        var mouseOver = true;
        if (Object.keys(trails.features).length > 200) {
            mouseOver = false;
        }

        var map = L.map('map', {
            rotate: true,
            rotateControl: {
                closeOnZeroBearing: false,
            },
            touchRotate: false,
            bearing: {{mountain.bearing()}},
            almostOnMouseMove: mouseOver,
        }).setView([{{mountain.coordinates.y}},{{mountain.coordinates.x}}], 13);

        run_map(trails, map);
    </script>
    {% else %}
    <p>Select a resort above to view it.</p>
    {% endif %}
{% endblock insideContent %}
