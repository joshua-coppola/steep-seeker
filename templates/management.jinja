{% extends "page_base.jinja" %}
{% block title %}
Management Panel
{% endblock title %}

{% block pagehead %}
{% endblock pagehead %}

{% block content %}
<div class="map-pane mountain-details">
    <h1>Management Panel</h1>

    <ul class="nav-list">
        {% for link in management_links %}
        <li><div class="button"><a href="{{link.to}}" {% if active_page == link.title %} class="button-cta" {% else %} class="button-cta2" {% endif %}>
                        {{link.title}}
                    </a></div></li>
        {% endfor %}
    </ul>

{% block insideContent %}
{% endblock insideContent %}
</div>

<div id="processing-overlay" hidden>
    <div class="spinner" role="status" aria-label="Processing"></div>
    <p>Processing&hellip; this can take a few minutes.</p>
</div>
<script>
    (function () {
        var overlay = document.getElementById("processing-overlay");

        document.querySelectorAll(".map-pane form").forEach(function (form) {
            form.addEventListener("submit", function () {
                overlay.hidden = false;
            });
        });

        // Hide the overlay if the page is restored from the bfcache
        // (e.g. the user hits Back), so it isn't left spinning forever.
        window.addEventListener("pageshow", function () {
            overlay.hidden = true;
        });
    })();
</script>
{% endblock content %}
