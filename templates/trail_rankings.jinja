{% extends "page_base.jinja" %}
{% import "filters_sidebar.jinja" as filters with context %}

{% block title %}
Trail Rankings - Find the Hardest Trails in the USA
{% endblock title %}

{% block pagehead %}
{{ filters.head() }}
<link href="{{ asset_url('/trail_rankings.css') }}" rel="stylesheet" />
{% endblock pagehead %}

{% block content %}
{# trails are filtered by their resort's location/season pass; difficulty,
   trail count and vertical describe a mountain, so they're left out. On
   phones one toggle folds away both the filters and the explanation #}
{{ filters.sidebar("Trail Rankings", 107, toggle_label="Filters & Info", also_controls="ranking-info", groups="location,season_pass") }}

<section id="content" class="pane trail-rankings-page">
    <h1 class="desktop-title">Trail Rankings</h1>

    {# folded away on phones, behind the sidebar's Filters & Info toggle #}
    <div id="ranking-info" class="collapsible">
        {# the card layout's sort buttons; the table sorts by its headers #}
        <ul class="ranking-sort mobile">
            {% set sorts = [("difficulty", "Difficulty")] %}
            {% for key, label in pitch_fields %}
                {% set _ = sorts.append((key, label ~ " Pitch")) %}
            {% endfor %}

            {% for key, label in sorts %}
                <li>
                    {% if sort_by == key %}
                        <a class="button-cta">{{ label }}</a>
                    {% else %}
                        <a class="button-cta2" href="{{ pages.first }}&sort={{ key }}">
                            {{ label }}
                        </a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>

        <p class="detail">
            The trails can be filtered by their resort's location and season pass, and sorted by the length of the
            steepest pitch. Keep in mind that trail difficulties are calculated using the 150 foot pitch value, as well
            as other factors not shown here.
        </p>
    </div>

    <div class="share-row"><button type="button" class="button-cta2 share-button" data-share>Share⤷</button></div>

    <div class="legend">
        <ul>
            <li><span class="icon difficulty-green"></span>Beginner</li>
            <li><span class="icon difficulty-royalblue"></span>Intermediate</li>
            <li><span class="icon difficulty-black"></span>Advanced</li>
            <li><span class="icon difficulty-red"></span>Expert</li>
            <li><span class="icon difficulty-gold"></span>Extreme</li>
            <li><span class="icon gladed"></span>Gladed</li>
            <li><span class="icon ungroomed"></span>Ungroomed</li>
            <li><span class="icon hazardous"></span>Hazardous</li>
        </ul>
    </div>

    <div id="ezoic-pub-ad-placeholder-102"></div>

    <div class="links">
        {% if 'prev' in pages %}
        <div class="column-left">
            <a class="button-cta2" href="{{pages.prev}}">&#x25C0; Previous Page</a>
        </div>
        {% endif %}

        {% if 'next' in pages %}
        <div class="column-right">
            <a class="button-cta2" href="{{pages.next}}">Next Page &#x25B6;</a>
        </div>
        {% endif %}
    </div>

    <div class="trail-table desktop">
        <table>
            <tr>
                <th>Trail Name</th>
                <th>Resort</th>
                <th>State</th>
                {% if sort_by == "difficulty"%}
                <th><a class="active">Difficulty</a></th>
                {% else %}
                <th><a href="{{pages.first}}&sort=difficulty">Difficulty</a></th>
                {% endif %}
                {% for field, label in pitch_fields %}
                {% if sort_by == field %}
                <th><a class="active">{{ label }} Pitch</a></th>
                {% else %}
                <th><a href="{{pages.first}}&sort={{ field }}">{{ label }} Pitch</a></th>
                {% endif %}
                {% endfor %}
            </tr>
            {% for trail in trails %}
            {% if not '' == trail.name %}
            <tr>
                <td>
                    <p>{{pages.offset + loop.index}}. <a href="/interactive-map/{{trail.state.value}}/{{trail.resort_name}}?select=trail:{{trail.trail_id}}">
                            {{trail.name}}</a>
                            {% if trail.gladed == True %}
                            <span class="icon gladed"></span>
                            {% endif %}
                            {% if trail.ungroomed == True%}
                            <span class="icon ungroomed"></span>
                            {% endif %}
                            {% if trail.hazardous == True%}
                            <span class="icon hazardous"></span>
                            {% endif %}
                        </p>
                </td>
                <td>
                    <a href="/interactive-map/{{trail.state.value}}/{{trail.resort_name}}?select=trail:{{trail.trail_id}}">{{trail.resort_name}}</a>
                    {% for season_pass in trail.season_passes %}
                    <img src="icons/{{season_pass.value}}.{{'svg' if season_pass.value == 'Snow Pass' else 'png'}}" class="pass-icon" alt="{{season_pass.value}}"/>
                    {% endfor %}
                </td>
                <td>{{trail.state.value}}</td>
                <td>
                    <span class="icon difficulty-{{ trail_color(trail.difficulty) }}"></span>
                    {{trail.difficulty}}
                </td>
                {% for field, label in pitch_fields %}
                <td>
                    {% if trail[field] != None %}
                    <span class="icon difficulty-{{ trail_color(trail[field]) }}"></span>
                    {{trail[field]}}°
                    {% else %}
                    --
                    {% endif %}
                </td>
                {% endfor %}
            </tr>
            {% endif %}
            {% endfor %}

        </table>
    </div>

    {# ads between results (see inline_ad_slots) only go in this phone
       layout; the desktop table has no spot for them #}
    {% set inline_ads = inline_ad_slots(trails|length) %}
    <div class="trail-table mobile">
        {% for trail in trails %}
        {% if not '' == trail.name %}
        <div class="header">
            <table class="header">
                <tr>
                    <td>
                        <p>{{pages.offset + loop.index}}. <a href="/interactive-map/{{trail.state.value}}/{{trail.resort_name}}?select=trail:{{trail.trail_id}}">
                                {{trail.name}}</a>
                                {% if trail.gladed == True %}
                                <span class="icon gladed"></span>
                                {% endif %}
                                {% if trail.ungroomed == True%}
                                <span class="icon ungroomed"></span>
                                {% endif %}
                                {% if trail.hazardous == True%}
                                <span class="icon hazardous"></span>
                                {% endif %}
                        </p>
                        {# the resort on its own line under the trail, like the table's
                           Resort column #}
                        <p class="card-resort"><a href="/interactive-map/{{trail.state.value}}/{{trail.resort_name}}?select=trail:{{trail.trail_id}}">
                                {{trail.resort_name}} ({{trail.state.value}})</a>
                            {% for season_pass in trail.season_passes %}
                            <img src="icons/{{season_pass.value}}.{{'svg' if season_pass.value == 'Snow Pass' else 'png'}}" class="pass-icon" alt="{{season_pass.value}}"/>
                            {% endfor %}
                        </p>
                    </td>
                </tr>
            </table>
        </div>
        <table>
            {% if sort_by == "difficulty"%}
            <tr style="background-color: var(--color-accent-very-light)">
            {% else %}
            <tr>
            {% endif %}
                <td style="width:50%">Difficulty</td>
                <td style="width:50%">
                    <span class="icon difficulty-{{ trail_color(trail.difficulty) }}"></span>
                    {{trail.difficulty}}
                </td>
            </tr>
            {% for field, label in pitch_fields %}
            {% if sort_by == field %}
            <tr style="background-color: var(--color-accent-very-light)">
            {% else %}
            <tr>
            {% endif %}
                <td>{{ label }} Pitch</td>
                <td>
                    {% if trail[field] != None %}
                    <span class="icon difficulty-{{ trail_color(trail[field]) }}"></span>
                    {{trail[field]}}°
                    {% else %}
                    --
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </table>
        {% endif %}
        {% if loop.index in inline_ads %}
        <div class="inline-ad" id="ezoic-pub-ad-placeholder-{{ inline_ads[loop.index] }}"></div>
        {% endif %}
        {% endfor %}
    </div>

    <div class="links">
        {% if 'prev' in pages %}
        <div class="column-left">
            <a class="button-cta2" href="{{pages.prev}}">&#x25C0; Previous Page</a>
        </div>
        {% endif %}

        {% if 'next' in pages %}
        <div class="column-right">
            <a class="button-cta2" href="{{pages.next}}">Next Page &#x25B6;</a>
        </div>
        {% endif %}
    </div>
    <div id="ezoic-pub-ad-placeholder-101"></div>
    <script>
        ezstandalone.cmd.push(function () {
            const ads = [101, 102];
            const inlineAds = {{ inline_ads.values()|list|tojson }};
            // the ads between results (see inline_ad_slots) are only in the
            // card layout (trail_rankings.css shows it when the results pane
            // is too narrow for the table), so drop them while the table
            // shows instead of requesting ads for them
            if (document.querySelector(".trail-table.mobile").checkVisibility()) {
                ads.push(...inlineAds);
            } else {
                inlineAds.forEach(function (id) {
                    document.getElementById("ezoic-pub-ad-placeholder-" + id).remove();
                });
            }
            // the sidebar ad slot (107) overflows and breaks the layout when an ad
            // fills it with less than 300px of room, so drop it then instead of
            // requesting an ad for it; this also covers the mobile layout, which
            // hides the sidebar (0px wide)
            const sidebarAd = document.getElementById("ezoic-pub-ad-placeholder-107");
            if (sidebarAd.offsetWidth < 300) {
                sidebarAd.remove();
            } else {
                ads.push(107);
            }
            ezstandalone.showAds(...ads);
        });
    </script>

</section>
{% endblock content %}

{% block postbody %}
{{ filters.script() }}
{% endblock postbody %}
