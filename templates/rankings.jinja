{% extends "page_base.jinja" %}
{% import "filters_sidebar.jinja" as filters with context %}

{% block title %}
Mountain Rankings - Find the Easiest and Hardest Resorts in the USA
{% endblock title %}

{% block pagehead %}
{{ filters.head() }}
<link href="{{ asset_url('/rankings.css') }}" rel="stylesheet" />
{% endblock pagehead %}

{% block content %}
{# on phones one toggle folds away both the filters and the explanation #}
{{ filters.sidebar("Mountain Rankings", 107, toggle_label="Filters &amp; Info", also_controls="ranking-info") }}

<section id="content" class="pane">
    <h1 class="desktop-title">Mountain Rankings</h1>

    <ul class="ranking-sort">
        {% for link in sort_links %}
        <li>
            <a href="{{ link.url }}" class="{{ 'button-cta' if link.active else 'button-cta2' }}">
                {{ link.label }}{% if link.active %} {% if order == "desc" %}&#x25bc;{% else %}&#x25b2;{% endif %}{% endif %}
            </a>
        </li>
        {% endfor %}
    </ul>

    {# folded away on phones, behind the sidebar's Filters & Info toggle #}
    <div id="ranking-info" class="collapsible">
        <p class="detail">
            {% if sort == "beginner" %}
            The Beginner Friendliness ranking is a weighted average of the easiest trails at each resort. It shows how easy
            it would be to learn to ski on these trails.
            The color denotes what the easiest trails at a mountain are rated. The higher the score, the easier the learning
            terrain is.
            {% endif %}
            {% if sort == "difficulty"%}
            Each difficulty ranking is a weighted average of the hardest trails at a 
            particular resort. These rankings indicated how challenging trails will be for 
            advanced skiers. Expect that the toughest trails at a resort will have pitches 
            in degrees that are similar to the difficulty score. This score is primarily 
            based on five most difficult runs at a particular resort, which means that a 
            resort with only challenging trails will rank below a mountain that has a 
            few not as challenging advanced runs.
            {% endif %}
        </p>

        <p class="detail">
            {% if sort == "beginner" %}
            The Beginner Friendliness scale is from 0-{{ beginner_friendliness_max }}, where 0 is a resort with no trails even resembling a good
            place to learn. The best resorts for beginners have a wide variety of easy terrain, and their scores will
            be high to reflect that.
            {% endif %}
            {% if sort == "difficulty"%}
            The difficulty scale is roughly from 0-60, where a mountain scoring highly 
            presents extremely difficult terrain. Technically, the max possible score is 
            ~100, but that does not exist in practice. The steepest terrain is primarily 
            in the west, and as such western resorts dominate the top of the difficulty 
            list.
            {% endif %}
        </p>
    </div>

    <div class="share-row"><button type="button" class="button-cta2 share-button" data-share>Share⤷</button></div>

    <div id="ezoic-pub-ad-placeholder-102"></div>

    <div class="legend">
        <ul>
            <li><span class="icon difficulty-green"></span>Beginner</li>
            <li><span class="icon difficulty-royalblue"></span>Intermediate</li>
            <li><span class="icon difficulty-black"></span>Advanced</li>
            <li><span class="icon difficulty-red"></span>Expert</li>
            <li><span class="icon difficulty-gold"></span>Extreme</li>
        </ul>
    </div>

    {# more than 25 results get an ad in the middle, more than 50 one every 50 #}
    {% set inline_ads = inline_ad_slots(mountains|length, 26, 50, 50) %}
    <div class="rankings">
        {% for mountain in mountains %}
        {% if sort == "difficulty" %}
        {% set bar_color = trail_color(mountain.difficulty) %}
        <p>{{loop.index}}.
            <a href="/interactive-map/{{mountain.state.value}}/{{mountain.name}}"
                title="Difficulty: {{mountain.difficulty}}">
                {{mountain.name}}, {{mountain.state.value}}
            </a>
            {% for season_pass in mountain.season_passes %}
            <img src="icons/{{season_pass.value}}.{{'svg' if season_pass.value == 'Snow Pass' else 'png'}}" class="pass-icon"/>
            {% endfor %}
        </p>

        <div class="bar-div"><span class="{{'ranking-bar' if bar_color != 'gold' else 'black-text'}}"
            title="{{mountain.name}} Difficulty: {{mountain.difficulty}}"
            style="--bar-size: {{
                (mountain.difficulty)/56 * 100}}%; --bar-color: {{ bar_color }};">{{mountain.difficulty}}
        </span></div>
        {% endif %}
        {% if sort == "beginner" %}
        <p>{{loop.index}}.
            <a href="/interactive-map/{{mountain.state.value}}/{{mountain.name}}"
                title="Beginner Friendliness: {{mountain.beginner_friendliness}}">
                {{mountain.name}}, {{mountain.state.value}}
            </a>
            {% for season_pass in mountain.season_passes %}
            <img src="icons/{{season_pass.value}}.{{'svg' if season_pass.value == 'Snow Pass' else 'png'}}" class="pass-icon"/>
            {% endfor %}
        </p>
        <div class="bar-div"><span class="ranking-bar" title="{{mountain.name}} Beginner Friendliness: {{mountain.beginner_friendliness}}"
            style="--bar-size: {{
                (mountain.beginner_friendliness)/beginner_friendliness_max * 100}}%; --bar-color: {{ beginner_color(mountain.beginner_friendliness) }};">{{mountain.beginner_friendliness}}
        </span></div>
        {% endif %}
        {% if loop.index in inline_ads %}
        {# an <aside>, not a <div>, so rankings.css's nth-of-type striping skips it #}
        <aside class="inline-ad"><div id="ezoic-pub-ad-placeholder-{{ inline_ads[loop.index] }}"></div></aside>
        {% endif %}
        {% endfor %}
    </div>
    {% if not mountains %}
    <p class="detail">No mountains match these filters.</p>
    {% endif %}
    <div id="ezoic-pub-ad-placeholder-101"></div>
    <script>
        ezstandalone.cmd.push(function () {
            // the ads between results (see inline_ad_slots) show at every width
            const ads = [101, 102].concat({{ inline_ads.values()|list|tojson }});
            // the sidebar ad slot (107) overflows and breaks the layout when an ad
            // fills it with less than 300px of room, so drop it then instead of
            // requesting an ad for it; this also covers the mobile layout, which
            // hides the sidebar (0px wide)
            const sidebarAd = document.getElementById("ezoic-pub-ad-placeholder-107");
            if (sidebarAd.offsetWidth < 300) {
                sidebarAd.remove();
            } else {
                ads.push(107);
            }
            ezstandalone.showAds(...ads);
        });
    </script>

</section>
{% endblock content %}

{% block postbody %}
{{ filters.script() }}
{% endblock postbody %}
