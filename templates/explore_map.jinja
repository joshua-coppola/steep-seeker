{% extends "page_base.jinja" %}
{% import "filters_sidebar.jinja" as filters with context %}

{% block title %}
Explore Resorts - Find Ski Resorts Across the USA
{% endblock title %}

{% block pagehead %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
     integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
     crossorigin=""></script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.locatecontrol/dist/L.Control.Locate.min.css" />
<script src="https://cdn.jsdelivr.net/npm/leaflet.locatecontrol/dist/L.Control.Locate.min.js" charset="utf-8"></script>
<script src="{{ asset_url('/tile-layer.js') }}"></script>

{{ filters.head() }}
<link href="{{ asset_url('/explore.css') }}" rel="stylesheet" />
{% endblock pagehead %}

{% block content %}
{# the same filters as search, applied to the map's markers in place
   (explore.js) rather than by reloading; on phones the sidebar is a panel
   over the map (with the legend in it), opened by #filtersButton like the
   map pages' Details #}
{% call filters.sidebar(None, 124, apply_in_page=True) %}
    <p id="match-count" class="match-count" aria-live="polite"></p>
    {# phone only (explore.css), shown under the title there; the map's own
       legend box takes the place of this one on wider screens #}
    <div class="legend-mobile">
        <p class="legend-heading">Legend</p>
        <ul>
            <li><span class="icon difficulty-green"></span> Beginner</li>
            <li><span class="icon difficulty-royalblue"></span> Intermediate</li>
            <li><span class="icon difficulty-black"></span> Advanced</li>
            <li><span class="icon difficulty-red"></span> Expert</li>
            <li><span class="icon difficulty-gold"></span> Extreme</li>
        </ul>
    </div>
{% endcall %}

{# just the map, edge to edge in its pane like the interactive map's, and
   no title at any width (the sidebar's is turned off above) #}
<section id="content" class="pane">
    <div class="map-wrap">
        <button type="button" class="button-cta2 map-button" id="filtersButton" aria-expanded="false"
            aria-controls="sidebar">
            Filters &amp; Legend
            <img alt="" height="17" width="17" src="/hamburger-menu-light.svg">
        </button>
        <div id="map"></div>
    </div>

    <script>
        ezstandalone.cmd.push(function () {
            // the sidebar ad slot (124, the same as the search page's)
            // overflows and breaks the layout when an ad fills it with less
            // than 300px of room, so drop it then instead of requesting an
            // ad for it; this also covers the phone layout, where the sidebar
            // is a hidden panel (0px wide). showAds() with no ids loads every
            // slot left on the page
            const sidebarAd = document.getElementById("ezoic-pub-ad-placeholder-124");
            if (sidebarAd.offsetWidth < 300) {
                sidebarAd.remove();
            }
            ezstandalone.showAds();
        });
    </script>
</section>
{% endblock content %}

{% block postbody %}
{{ filters.script() }}
<script src="{{ asset_url('/explore.js') }}"></script>
<script>
    runExploreMap({{ geojson | tojson }});
</script>
{% endblock postbody %}
