{% extends "page_base.jinja" %}

{% block title %}
Steep Seeker - Universal Ski Trail Rating System
{% endblock title %}

{% block pagehead %}
<link href="{{ asset_url('/index.css') }}" rel="stylesheet" />
{% endblock pagehead %}

{% block content %}
<section id="content">
    <div class="hero-image">
        <a href="/search">
            <img alt="Example Map - Brighton Ski Resort" src="/thumbnails/UT/Brighton.svg" width="500"/>
        </a>
    </div>
    <div class="hero-text">
        <h1><em>Steep Seeker:</em> Universal Ski Trail Ratings</h1>
        <div class="hero-links">
            <div class="button">
                <a href="/search" class="button-cta">Browse Mountains</a>
            </div>
            <div class="button">
                <a href="/about" class="button-cta2">Learn more</a>
            </div>
            <div class="button">
                <a href="/random-mountain" class="button-cta2">Random Mountain</a>
            </div>
        </div>
        <p>
            Steep Seeker provides detailed trail maps using a standardized difficulty
            scale. This means that a blue at one ski area is comparable to another,
            no matter which mountains are being compared. Since 2020, Steep Seeker has 
            helped over 100,000 skiers and snowboarders compare their favorite and 
            soon to be favorite ski trails.
        </p>

        <p>
            None of the ratings, trail information, or visuals are AI generated. Details about 
            how the ratings are calculated and where all the data comes from can be found
            on the <a href="/about">About</a> page.
        </p>

        <div class="community">
            <p>Want to join the community? Come chat about the slopes and get updates first.</p>
            <div class="social-links">
                <a href="https://discord.gg/yk9BKW8yFn"
                    target="_blank" rel="noopener"
                    aria-label="Join the Steepseeker Discord">
                    <img alt="" height="28" width="28" src="/icons/discord.svg" />
                </a>
                <a href="https://www.instagram.com/steepseeker/"
                    target="_blank" rel="noopener"
                    aria-label="Follow Steepseeker on Instagram">
                    <img alt="" height="28" width="28" src="/icons/instagram.svg" />
                </a>
            </div>
        </div>
    </div>
    {# no ad slots on this page, but Ezoic still needs showAds() to place
       its anchor ad, as on the About page #}
    <script>
        ezstandalone.cmd.push(function () {
            ezstandalone.showAds();
        });
    </script>

</section>
{% endblock content %}
