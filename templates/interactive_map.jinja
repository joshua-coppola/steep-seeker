{% extends "map_page_base.jinja" %}
{% import "map_macros.jinja" as map_macros with context %}

{# Sidebar rows select and zoom to their trail/lift on this map #}
{% set selectable_sidebar = true %}

{% block map_title %}Interactive Trail Map{% endblock map_title %}

{% block map_head %}
{{ map_macros.leaflet_assets() }}
{% endblock map_head %}

{% block map_view %}
    <div id='map'></div>
    <div class="map-switch">
        <button class="button-cta2 map-button" id="static"><a href="/map/{{mountain.state.value}}/{{mountain.name}}">Static Map</a></button>
    </div>
{% endblock map_view %}

{% block map_script %}
    <script>
{{ map_macros.create_map_js(mountain) }}
        fetch("/interactive-map/{{mountain.state.value}}/{{mountain.name}}/geojson{% if debug_mode %}?debug=true{% endif %}")
            .then(function (response) { return response.json(); })
            .then(function (trails) {
                run_map(trails, createMountainMap(trails));
            });
    </script>
{% endblock map_script %}
